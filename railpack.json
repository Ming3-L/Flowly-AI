{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "steps": {
    "install": {
      "inputs": [{ "local": true, "include": ["."] }],
      "commands": ["pip install -r requirements.txt"]
    }
  },
  "deploy": {
    "startCommand": "cd Backend && sh start.sh"
  }
}
