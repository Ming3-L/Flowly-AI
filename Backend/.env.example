# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# MySQL: mysql://user:password@host:port/database_name
# SQLite: sqlite:///db.sqlite3
DATABASE_URL=mysql://flowly:flowly_password@localhost:3306/flowly_db

# Redis Configuration (for Channels / Celery)
REDIS_URL=redis://localhost:6379/0
# Channels：默认使用 Redis。若本机暂时无 Redis，可改为 true 使用内存层（仅开发、单进程）。
# USE_INMEMORY_CHANNEL_LAYER=true

# AI Configuration
# 也可将密钥写在 ai_engine/integrations/project_secrets_local.py（从
# project_secrets_local.example.py 复制，该文件已 gitignore）。环境变量非空时优先。
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 火山方舟 / 豆包（OpenAI 兼容 Chat Completions，密钥勿提交仓库；泄露请立即轮换）
# DOUBAO_API_KEY 与 ARK_API_KEY 任填其一即可。
DOUBAO_API_KEY=
ARK_API_KEY=
DOUBAO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 控制台推理接入点 ID，一般为 ep- 开头
DOUBAO_ARK_MODEL=
# 已配置豆包密钥时，是否把路由名 openai 默认切到方舟：1=是（默认），0=否
FLOWLY_USE_DOUBAO_DEFAULT=1

# Vector Engine API (OpenAI-compatible proxy for Codex)
# Set VECTORENGINE_API_KEY to use this provider instead of OpenAI
# 切勿将真实密钥提交到仓库；仅在本地 .env 中填写。
VECTORENGINE_API_KEY=
VECTORENGINE_BASE_URL=
VECTORENGINE_MODEL=

# ── Phase 3: Multi-Model Support ──────────────────────────────────────────────
# Anthropic Claude (set ANTHROPIC_API_KEY to enable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local models, set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend Configuration
VITE_API_BASE_URL=/api

# 本机屏幕代理 / 自动回复区域检测：YOLO 权重（可选；不填则自动使用仓库根目录 best.pt）
# FLOWLY_SCREEN_YOLO_WEIGHTS=D:\project\Flowly-AI\best.pt

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Settings
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai
USE_TZ=True

# ── LangSmith Tracing (optional) ────────────────────────────────────────────────
# Enable to get full workflow traces with LLM calls, tokens, and timings.
# Sign up at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=flowly-ai
