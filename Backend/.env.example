# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# MySQL: mysql://user:password@host:port/database_name
# SQLite: sqlite:///db.sqlite3
DATABASE_URL=mysql://flowly:flowly_password@localhost:3306/flowly_db

# Redis Configuration (for Channels)
REDIS_URL=redis://localhost:6379/0

# AI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Vector Engine API (OpenAI-compatible proxy for Codex)
# Set VECTORENGINE_API_KEY to use this provider instead of OpenAI
VECTORENGINE_API_KEY=sk-iDT0A0a4bXmSNYGPcarN2ud4IZlNvty9SsNUxIpe6av3ezcQ
VECTORENGINE_BASE_URL=https://api.vectorengine.cn/v1
VECTORENGINE_MODEL=codex

# ── Phase 3: Multi-Model Support ──────────────────────────────────────────────
# Anthropic Claude (set ANTHROPIC_API_KEY to enable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local models, set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend Configuration
VITE_API_BASE_URL=/api

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Settings
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai
USE_TZ=True

# ── LangSmith Tracing (optional) ────────────────────────────────────────────────
# Enable to get full workflow traces with LLM calls, tokens, and timings.
# Sign up at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=flowly-ai
