# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# MySQL: mysql://user:password@host:port/database_name
# SQLite: sqlite:///db.sqlite3
DATABASE_URL=mysql://flowly:flowly_password@localhost:3306/flowly_db

# Redis Configuration (for Channels / Celery)
REDIS_URL=redis://localhost:6379/0
# Channels：默认使用 Redis。若本机暂时无 Redis，可改为 true 使用内存层（仅开发、单进程）。
# USE_INMEMORY_CHANNEL_LAYER=true

# AI Configuration
# 也可将密钥写在 ai_engine/integrations/project_secrets_local.py（从
# project_secrets_local.example.py 复制，该文件已 gitignore）。
#
# 平台统一接入（推荐生产）：管理员在「后台管理 → 接入配置 (密钥)」写入数据库（Fernet 加密），
# 运行时优先于本文件中的变量。从本文件迁库：启动服务后点「从环境变量导入」，或执行：
#   python manage.py import_ai_secrets_from_env
#   python manage.py import_ai_secrets_from_env --replace
#
# 若变更 Django SECRET_KEY，数据库中 Fernet 加密的接入配置将无法解密，需重新在后台填写或从环境导入。
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 火山方舟 / 豆包（OpenAI 兼容 Chat Completions，密钥勿提交仓库；泄露请立即轮换）
# DOUBAO_API_KEY 与 ARK_API_KEY 任填其一即可。
DOUBAO_API_KEY=
ARK_API_KEY=
DOUBAO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 控制台推理接入点 ID，一般为 ep- 开头
DOUBAO_ARK_MODEL=ep-xxxxxxxxxxxxxxxx
# Smart-Router 专用推理接入点（可选，ep-...）
DOUBAO_ARK_SMART_ROUTER_ENDPOINT=
# 已配置豆包密钥时，是否把路由名 openai 默认切到方舟：1=是（默认），0=否
FLOWLY_USE_DOUBAO_DEFAULT=1

# ── 豆包语音（OpenSpeech，TTS/ASR 独立鉴权）─────────────────────────────────────
# 注意：语音类接口不使用方舟 ARK_API_KEY，需要单独在火山语音控制台申请。
OPENSPEECH_APPID=
OPENSPEECH_ACCESS_TOKEN=
# 新版控制台推荐：API Key（用于 OpenSpeech v3 接口，如 seed-tts-2.0）
OPENSPEECH_API_KEY=
# 可选：不填会使用默认值
OPENSPEECH_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
OPENSPEECH_CLUSTER=volcano_tts
# 示例音色（建议根据你购买/开通的音色填写）
OPENSPEECH_VOICE_TYPE=zh_male_M392_conversation_wvae_bigtts
# 可选：TTS 音色列表（二级下拉），JSON 数组：
# - 纯字符串数组：["voice_type_a","voice_type_b"]
# - 或对象数组：[{ "id": "female_1", "label": "女声·温柔", "voice_type": "xxx" }]
OPENSPEECH_TTS_VOICES_JSON=
# v3 / 语音合成 2.0（seed-tts-2.0）默认 speaker（音色ID）
OPENSPEECH_TTS2_SPEAKER=zh_female_vv_uranus_bigtts
# v3 / 语音合成 2.0 音色列表（二级下拉），JSON 数组（字符串= speaker）：
# ["zh_female_vv_uranus_bigtts","zh_male_xxx"]
OPENSPEECH_TTS2_VOICES_JSON=

# ASR（当前用于存储；后续接入 WebSocket/SDK 时直接复用）
OPENSPEECH_ASR_STREAM_CLUSTER=volc_streaming_asr
OPENSPEECH_ASR_FILE_CLUSTER=volc_asr

# Vector Engine API (OpenAI-compatible proxy for Codex)
# Set VECTORENGINE_API_KEY to use this provider instead of OpenAI
# 切勿将真实密钥提交到仓库；仅在本地 .env 中填写。
VECTORENGINE_API_KEY=
VECTORENGINE_BASE_URL=
VECTORENGINE_MODEL=

# ── Phase 3: Multi-Model Support ──────────────────────────────────────────────
# Anthropic Claude (set ANTHROPIC_API_KEY to enable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local models, set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend Configuration
VITE_API_BASE_URL=/api

# 本机屏幕代理 / 自动回复区域检测：YOLO 权重（可选；不填则自动使用后端默认位置的 best.pt）
# FLOWLY_SCREEN_YOLO_WEIGHTS=D:\project\Flowly-AI\Backend\ai_engine\desktop_screen_agent\weights\best.pt

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Settings
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai
USE_TZ=True

# ── LangSmith Tracing (optional) ────────────────────────────────────────────────
# Enable to get full workflow traces with LLM calls, tokens, and timings.
# Sign up at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=flowly-ai

# ── Admin Invite Codes ──────────────────────────────────────────────────────────
# 注册时填写邀请码，可创建对应权限账号：
# - 普通管理员（is_staff=true）
# - 超级管理员（is_superuser=true）
#
# 使用方式：复制本文件为 Backend/.env，然后填入你自己的随机邀请码（不要提交到仓库）。
FLOWLY_ADMIN_REGISTER_INVITE=
FLOWLY_SUPERUSER_REGISTER_INVITE=

# 第三方（如火山方舟）从公网拉取本地上传图/视频参考帧时，需配置站点根 URL（无尾斜杠）
# 例如 https://your-domain.com ；开发机若仅本机使用可留空（图生视频可能仅文生）
FLOWLY_PUBLIC_BASE_URL=
